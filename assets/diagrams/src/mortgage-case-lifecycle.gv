// Figure 1-2 — The cumulative mortgage case, its first bottleneck, and the
// ownership boundaries that later chapters will extend.
digraph mortgage_case_lifecycle {
  rankdir = TB
  graph [ranksep=0.18, nodesep=0.20]
  node [width=2.05, fontsize=10.5]

  intake [label="Synthetic intake\nMORT-2026-000184", shape=note,
          fillcolor="#E6F5F9", color="#0B6076"]
  summary [label="Evidence summary\nmodel candidate", fillcolor="#E7F5F3", color="#0D6E69"]
  missing [label="Required evidence\ncomplete?", shape=diamond,
           fillcolor="#FFF4DF", color="#8A5600"]
  request [label="Request missing\npay statement", fillcolor="#EAF3FB", color="#1450A3"]
  verify [label="Verify evidence\nsource + freshness", fillcolor="#EAF3FB", color="#1450A3"]
  calculate [label="Calculate\nDecimal ratios", fillcolor="#EAF3FB", color="#1450A3"]
  review [label="Underwriter review\nhuman decision", fillcolor="#F7ECF8", color="#6A2E6E"]
  los [label="Loan-origination\nsystem", shape=box, style="filled", fillcolor="#EEF4FA", color="#4A6078"]
  stop [label="No approval\nno external write", fillcolor="#FCECEC", color="#A62C2C"]

  intake -> summary [label="  metadata only  ", style=dotted, color="#0B6076", fontcolor="#0B6076"]
  summary -> missing [label="  candidate  ", color="#0D6E69", fontcolor="#0D6E69"]
  missing -> request [label="  no  ", color="#8A5600", fontcolor="#8A5600"]
  missing -> verify [label="  yes  ", color="#1450A3", fontcolor="#1450A3"]
  request -> verify [label="  after arrival  ", style=dashed, color="#1450A3", fontcolor="#1450A3"]
  verify -> calculate [label="  accepted evidence  ", color="#1450A3", fontcolor="#1450A3"]
  calculate -> review [label="  recommendation  ", color="#6A2E6E", fontcolor="#6A2E6E"]
  review -> los [label="  authorized effect only  ", style=dashed, color="#6A2E6E", fontcolor="#6A2E6E"]
  summary -> stop [label="  unsupported claim  ", style=dashed, color="#A62C2C", fontcolor="#A62C2C"]
}
