// Figure 22-1 — Protected effect lifecycle.
// Message: an unknown outcome is a durable stop, not a failed request that can
// be blindly retried; compensation is a new business effect. The effect is
// reserved before approval so duplicate proposals awaiting it share one key.
digraph effect_lifecycle {
  rankdir = TB
  graph [ranksep=0.35, nodesep=0.30]
  node [width=1.75, fontsize=11]

  proposal [label="Typed proposal\ncanonical intent", fillcolor="#E7F5F3", color="#0D6E69"]
  approval [label="Approval gate\nR3/R4 only", shape=diamond, fillcolor="#FFF4DF", color="#8A5600"]
  reserved [label="Reserved\nlogical key + hash", fillcolor="#EAF3FB", color="#1450A3"]
  executing [label="Executing\ndownstream request ID", fillcolor="#EAF3FB", color="#1450A3"]
  committed [label="Committed\nverified receipt", fillcolor="#F7ECF8", color="#6A2E6E"]
  declined [label="Declined\nproven absent", fillcolor="#EEF4FA", color="#4A6078"]
  unknown [label="Unknown\nstop dependent work", fillcolor="#FCECEC", color="#A62C2C"]
  reconcile [label="Reconcile\nquery downstream", shape=diamond, fillcolor="#FFF4DF", color="#8A5600"]
  partial [label="Partial\nintervention path", fillcolor="#FCECEC", color="#A62C2C"]
  intervention [label="InterventionRequired\nno safe automatic answer", fillcolor="#FCECEC", color="#A62C2C"]
  compensating [label="Compensating\nauthorized reversal", fillcolor="#FFF4DF", color="#8A5600"]
  compensated [label="Compensated\noriginal receipt retained", fillcolor="#F7ECF8", color="#6A2E6E"]

  proposal -> reserved [label="  reserve key  "]
  reserved -> executing [label="  R0–R2: dispatch once  "]
  reserved -> approval [label="  R3/R4  ", style=dashed, color="#8A5600", fontcolor="#8A5600"]
  approval -> executing [label="  approved: dispatch once  ", style=dashed]
  approval -> declined [label="  denied/expired  ", style=dashed, color="#A62C2C", fontcolor="#A62C2C"]
  reserved -> declined [label="  precondition fails  ", color="#A62C2C", fontcolor="#A62C2C"]
  executing -> committed [label="  receipt verified  "]
  executing -> unknown [label="  timeout/lost ack  ", color="#A62C2C", fontcolor="#A62C2C"]
  unknown -> reconcile [label="  no blind retry  ", style=dashed, color="#8A5600", fontcolor="#8A5600"]
  reconcile -> committed [label="  found committed  "]
  reconcile -> declined [label="  proven absent  "]
  reconcile -> partial [label="  some changes  "]
  reconcile -> intervention [label="  cannot prove  "]
  committed -> compensating [label="  fresh approval  ", style=dashed]
  compensating -> compensated [label="  reversal receipt  "]
  compensating -> intervention [label="  reversal fails  ", color="#A62C2C", fontcolor="#A62C2C"]
}
