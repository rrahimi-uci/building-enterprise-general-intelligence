// Figure 23-1 — Containment across execution and network boundaries.
// Message: manipulated content can influence a proposal, but it cannot grant
// itself capabilities, credentials, destinations, or committed effects.
digraph sandbox_egress {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.28]
  node [width=1.85, fontsize=11]

  artifact [label="Supplier document\nuntrusted content", fillcolor="#FCECEC", color="#A62C2C"]
  inspect [label="Content inspection\nlabel + provenance + taint", fillcolor="#E6F5F9", color="#0B6076"]
  capability [label="Capability policy\ntool · data · purpose · risk", shape=diamond,
              fillcolor="#FFF4DF", color="#8A5600", width=2.1]
  model [label="Model proposal\nmay be manipulated", fillcolor="#E7F5F3", color="#0D6E69"]
  sandbox [label="Ephemeral sandbox\nnon-root · quotas · no secrets", fillcolor="#EAF3FB", color="#1450A3"]
  egress [label="Egress proxy\ncanonical destination", fillcolor="#EAF3FB", color="#1450A3"]
  dlp [label="DLP + publication policy\npayload class · approval", shape=diamond,
       fillcolor="#FFF4DF", color="#8A5600", width=2.1]
  credential [label="Secret broker\nlast-hop lease only", shape=note,
              fillcolor="#E6F5F9", color="#0B6076"]
  endpoint [label="Approved endpoint\nbounded request", fillcolor="#EDF3FC", color="#1450A3"]
  effect [label="Effect ledger\nreceipt or Unknown", fillcolor="#F7ECF8", color="#6A2E6E"]
  refused [label="Refused / quarantined\nreason + evidence", fillcolor="#FCECEC", color="#A62C2C"]

  artifact -> inspect [label="  ingest  "]
  inspect -> capability [label="  labeled context  "]
  capability -> model [label="  eligible scope  "]
  capability -> refused [label="  denied  ", color="#A62C2C", fontcolor="#A62C2C"]
  model -> sandbox [label="  bounded proposal  "]
  sandbox -> egress [label="  connection + payload  "]
  sandbox -> refused [label="  profile violation  ", color="#A62C2C", fontcolor="#A62C2C"]
  egress -> dlp [label="  one-use destination grant  ", style=dashed]
  credential -> egress [label="  scoped secret  ", style=dashed]
  dlp -> endpoint [label="  allowed  "]
  dlp -> refused [label="  blocked / approval missing  ", color="#A62C2C", fontcolor="#A62C2C"]
  endpoint -> effect [label="  external result  "]
}
