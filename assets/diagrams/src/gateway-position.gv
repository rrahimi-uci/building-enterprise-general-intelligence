// Figure 19-1 — LLM Gateway position relative to adjacent gateways.
// Message: it is a distinct control point. An API gateway does not understand
// prompts, and a tool gateway does not understand model routing.
digraph gateway_position {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.30]
  node [width=1.55, fontsize=12]

  agent [label="Agent runtime", fillcolor="#E7F5F3", color="#0D6E69"]
  api [label="API Gateway\nnorth–south traffic\nauthN · rate limits", fillcolor="#EEF4FA", color="#4A6078"]
  tool [label="Tool Gateway\neffects and receipts\nauthZ per action", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  llm [label="LLM Gateway\nmodel routing · redaction\nquota · telemetry", fillcolor="#FFF4DF", color="#8A5600", style=filled]
  sys [label="Enterprise systems", fillcolor="#EDF3FC", color="#1450A3", shape=cylinder, style=filled]
  prov [label="Model providers", fillcolor="#EEF4FA", color="#4A6078"]

  api -> agent [label="  user request  "]
  agent -> tool [label="  effects  "]
  agent -> llm [label="  inference  "]
  tool -> sys
  llm -> prov
  { rank=same; tool; llm }
  { rank=same; sys; prov }
}
