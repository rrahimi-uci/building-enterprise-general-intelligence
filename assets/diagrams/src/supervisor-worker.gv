// Figure 18-1 — Supervisor/worker, with the parts that make it governable.
//
// Message: the supervisor owns the outcome and never stops owning it. Each
// child gets a narrowed grant rather than a copy of the parent's, fan-in is an
// explicit contract rather than "whatever came back", and cancellation is a
// durable intent that a child with a running mutation must reconcile before it
// may acknowledge.
digraph supervisor_worker {
  rankdir = TB
  graph [ranksep=0.32, nodesep=0.20, pad=0.1]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=11.5,
        margin="0.10,0.07", height=0.42, width=1.5]
  edge [arrowsize=0.65, penwidth=1.5, color="#1450A3"]

  sup [label="Supervisor\nowns the outcome, always", fillcolor="#E7F5F3",
       color="#0D6E69", width=2.6]

  t1 [label="Child task\ndocument extraction", shape=note, style=filled,
      fillcolor="#EDF3FC", color="#1450A3"]
  t2 [label="Child task\nincome verification", shape=note, style=filled,
      fillcolor="#EDF3FC", color="#1450A3"]
  t3 [label="Child task\nproperty review", shape=note, style=filled,
      fillcolor="#EDF3FC", color="#1450A3"]

  w1 [label="Worker A", fillcolor="#E6F5F9", color="#0B6076"]
  w2 [label="Worker B", fillcolor="#E6F5F9", color="#0B6076"]
  w3 [label="Worker C", fillcolor="#E6F5F9", color="#0B6076"]

  join [label="Fan-in contract\nall · quorum · first valid · fallback",
        shape=diamond, style=filled, fillcolor="#FFF4DF", color="#8A5600",
        height=0.85, width=3.2]
  out  [label="Accepted outcome", fillcolor="#F7ECF8", color="#6A2E6E", width=2.0]

  grant [label="each child grant\nis an intersection,\nnever a copy",
         shape=plaintext, style="", fontsize=10.5, fontcolor="#A62C2C"]
  canc  [label="cancellation is\ndurable intent — a\nrunning mutation\nreconciles first",
         shape=plaintext, style="", fontsize=10.5, fontcolor="#A62C2C"]

  sup -> t1; sup -> t2; sup -> t3
  t1 -> w1; t2 -> w2; t3 -> w3
  w1 -> join; w2 -> join; w3 -> join
  join -> out [color="#8A5600"]
  sup -> join [color="#6A2E6E", style=dashed, arrowsize=0.5,
               label=" owns\n completion", fontsize=10.5, fontcolor="#6A2E6E",
               constraint=false]

  { rank=same; t1 -> t2 -> t3 -> grant [style=invis] }
  { rank=same; w1 -> w2 -> w3 -> canc  [style=invis] }
}
