// Figure 2-1 — The deterministic shell around one model proposal.
//
// Message: the model occupies exactly one box. Everything below it is ordinary
// code the enterprise owns, and every gate can refuse. The right-hand column is
// the point: each gate refuses for a distinct reason, which is why collapsing
// validate and authorize into one check silently loses a control.
//
// Layout: the flow runs downward because six gates side by side gives a 12:1
// strip that is half an inch tall at book width. Each rank pairs one gate with
// its refusal; column order is forced inside the rank=same group.
digraph deterministic_shell {
  rankdir = TB
  graph [ranksep=0.20, nodesep=0.38]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=11,
        margin="0.13,0.08", height=0.44, width=1.55]
  edge [arrowsize=0.7, penwidth=1.6]

  p [label="1 · Propose", fillcolor="#E7F5F3", color="#0D6E69"]
  v [label="2 · Validate", fillcolor="#EAF3FB", color="#1450A3"]
  a [label="3 · Authorize", fillcolor="#EAF3FB", color="#1450A3"]
  c [label="4 · Commit",   fillcolor="#F7ECF8", color="#6A2E6E"]
  y [label="5 · Verify",   fillcolor="#F7ECF8", color="#6A2E6E"]
  k [label="6 · Accept",   fillcolor="#FFF4DF", color="#8A5600"]

  hg [label=<<B><FONT POINT-SIZE="11" COLOR="#12233F">GATE</FONT></B>>, shape=plaintext, style=""]
  hr [label=<<B><FONT POINT-SIZE="11" COLOR="#A62C2C">WHAT IT REFUSES</FONT></B>>, shape=plaintext, style=""]

  pm [label="the model's only job", shape=plaintext, style="", fontsize=10, fontcolor="#0D6E69"]
  vm [label="malformed, or a tool version\nwe do not publish", fillcolor="#FCECEC", color="#A62C2C", fontsize=10, width=2.5]
  am [label="well-formed, but not permitted\nfor this subject and resource", fillcolor="#FCECEC", color="#A62C2C", fontsize=10, width=2.5]
  cm [label="a duplicate, recognised by\nits idempotency key", fillcolor="#FCECEC", color="#A62C2C", fontsize=10, width=2.5]
  ym [label="a timeout — unknown effect,\nreconcile before retrying", fillcolor="#FCECEC", color="#A62C2C", fontsize=10, width=2.5]
  km [label="evidence missing or staler\nthan policy allows", fillcolor="#FCECEC", color="#A62C2C", fontsize=10, width=2.5]

  hg -> p [style=invis]            // header only orders the column
  p -> v -> a -> c -> y -> k [color="#1450A3"]

  p -> pm [style=invis]
  v -> vm [color="#A62C2C", style=dashed, penwidth=1.2, arrowsize=0.55, constraint=false]
  a -> am [color="#A62C2C", style=dashed, penwidth=1.2, arrowsize=0.55, constraint=false]
  c -> cm [color="#A62C2C", style=dashed, penwidth=1.2, arrowsize=0.55, constraint=false]
  y -> ym [color="#A62C2C", style=dashed, penwidth=1.2, arrowsize=0.55, constraint=false]
  k -> km [color="#A62C2C", style=dashed, penwidth=1.2, arrowsize=0.55, constraint=false]

  { rank=same; hg -> hr [style=invis] }
  { rank=same; p -> pm [style=invis] }
  { rank=same; v -> vm [style=invis] }
  { rank=same; a -> am [style=invis] }
  { rank=same; c -> cm [style=invis] }
  { rank=same; y -> ym [style=invis] }
  { rank=same; k -> km [style=invis] }
}
