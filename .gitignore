# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors
.vscode/
.idea/
*.swp

# Release packaging output (written outside the repo by `make package`,
# but ignore any stray copies landing inside it)
*.zip

# LibreOffice / Word lock and temp files
.~lock.*#
~$*.docx

# XeLaTeX build directory — regenerated by `make pdf` / latex/compile.sh.
# The genuine PDF is published as a CI artifact and release asset, not committed.
latex/build/
dist/*.pdf

# Stray TeX auxiliaries if a build is ever run outside latex/build/
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
!latex/reference/*.pdf

# Examples virtualenv (pinned SDKs; created by `make setup-examples`)
.venv-examples/
.pytest_cache/
mlflow.db

# Reviewer feedback docx copies — kept locally only, not tracked
reviews-comments/*
!reviews-comments/.gitkeep
