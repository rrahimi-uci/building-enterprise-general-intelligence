// Figure 1-1 — The four levels from a model to an enterprise agentic system.
//
// Message: each level adds one capability and introduces one new class of
// failure, and the top level adds no intelligence at all -- only constraint and
// record-keeping. The right-hand column is the point of the figure: the reason
// to climb is never that the model gets better.
//
// Layout: three columns x five rows. Column order inside a row is forced by an
// invisible chain declared INSIDE the rank=same group -- without it dot orders
// a rank by edge structure and the columns scramble. Row order is forced by one
// invisible chain down the first column.
digraph capability_ladder {
  rankdir = TB
  graph [ranksep=0.30, nodesep=0.34]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=11,
        margin="0.14,0.09", height=0.46, width=1.95]

  h1 [label=<<B><FONT POINT-SIZE="11" COLOR="#12233F">LEVEL</FONT></B>>, shape=plaintext, style=""]
  h2 [label=<<B><FONT POINT-SIZE="11" COLOR="#0D6E69">WHAT IT ADDS</FONT></B>>, shape=plaintext, style=""]
  h3 [label=<<B><FONT POINT-SIZE="11" COLOR="#A62C2C">THE NEW FAILURE CLASS</FONT></B>>, shape=plaintext, style=""]

  r1 [label="1 · Model", fillcolor="#EEF4FA", color="#4A6078"]
  r2 [label="2 · Model + tools", fillcolor="#E6F5F9", color="#0B6076"]
  r3 [label="3 · Agent", fillcolor="#E7F5F3", color="#0D6E69"]
  r4 [label="4 · Enterprise system", fillcolor="#EAF3FB", color="#1450A3"]

  a1 [label="language\nunderstanding", fillcolor="#F4F8FB", color="#4A6078", penwidth=1.1]
  a2 [label="contact with\ncurrent reality", fillcolor="#F1FAFC", color="#0B6076", penwidth=1.1]
  a3 [label="adaptive\nmulti-step work", fillcolor="#F1FAF8", color="#0D6E69", penwidth=1.1]
  a4 [label="durability · authority\nevidence · control", fillcolor="#F4F8FD", color="#1450A3", penwidth=1.1]

  f1 [label="confidently wrong about\nfacts it cannot reach", fillcolor="#FCECEC", color="#A62C2C", fontsize=10]
  f2 [label="acts on data the caller\nwas never authorized to see", fillcolor="#FCECEC", color="#A62C2C", fontsize=10]
  f3 [label="runs forever; loses\neverything on restart", fillcolor="#FCECEC", color="#A62C2C", fontsize=10]
  f4 [label="complexity — which is why\nthe boundaries are explicit", fillcolor="#FFF4DF", color="#8A5600", fontsize=10]

  // Row order.
  h1 -> r1 -> r2 -> r3 -> r4 [style=invis]

  // Column order within each row. These must live inside the rank=same group.
  { rank=same; h1 -> h2 -> h3 [style=invis] }
  { rank=same; r1 -> a1 -> f1 [style=invis] }
  { rank=same; r2 -> a2 -> f2 [style=invis] }
  { rank=same; r3 -> a3 -> f3 [style=invis] }
  { rank=same; r4 -> a4 -> f4 [style=invis] }
}
