// Figure 25-1 — The continuous improvement loop.
// Message: production evidence returns as a versioned, approved change. The
// loop is closed but it is not automatic; approval is a step, not a formality.
digraph learning_loop {
  layout = circo
  graph [mindist=0.42]
  node [width=1.25, height=0.6, fontsize=10.5, fixedsize=true]

  observe   [label="Observe", fillcolor="#E7F5F3", color="#0D6E69"]
  measure   [label="Measure", fillcolor="#E7F5F3", color="#0D6E69"]
  detect    [label="Detect", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  diagnose  [label="Diagnose", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  recommend [label="Recommend", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  validate  [label="Validate", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  approve   [label="Approve\nhuman", fillcolor="#FFF4DF", color="#8A5600", style=filled]
  deploy    [label="Deploy", fillcolor="#F7ECF8", color="#6A2E6E"]
  monitor   [label="Monitor", fillcolor="#F7ECF8", color="#6A2E6E"]
  learn     [label="Learn", fillcolor="#E7F5F3", color="#0D6E69"]

  observe -> measure -> detect -> diagnose -> recommend -> validate
  validate -> approve -> deploy -> monitor -> learn -> observe
}
