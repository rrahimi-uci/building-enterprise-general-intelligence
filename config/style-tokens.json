  "callouts": {
    "contract": "Frame carries white title text; pale ground carries body ink. Every pair is contrast-tested at 4.5:1 or better in tools/validate_latex.py, and the DOCX shading is gated in tools/validate_book.py.",
    "kinds": {
      "Best practice": {
        "frame": "teal",
        "ground": "pale_teal"
      },
      "Architecture guidance": {
        "frame": "navy2",
        "ground": "pale_blue"
      },
      "Developer guideline": {
        "frame": "blue",
        "ground": "pale_indigo"
      },
