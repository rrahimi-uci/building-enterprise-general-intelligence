// Figure 12-1 — Plan-execute. Planning is compilation, not permission.
// Message: the model emits a candidate plan; a compiler turns it into typed IR
// that is validated against policy before any step runs. Replanning re-enters
// the compiler -- it never bypasses it.
digraph pattern_planning {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.24]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.12,0.07", height=0.40, width=1.6]
  edge [arrowsize=0.65, penwidth=1.5, color="#1450A3"]

  goal [label="Goal", fillcolor="#EEF4FA", color="#4A6078", width=1.2]
  plan [label="Candidate plan\nmodel output", fillcolor="#E7F5F3", color="#0D6E69", width=1.9]
  comp [label="Plan compiler\n→ typed IR", fillcolor="#EAF3FB", color="#1450A3", width=1.9]
  val  [label="Validate\npolicy · tools · budget", shape=diamond, style=filled,
        fillcolor="#FFF4DF", color="#8A5600", height=0.75, width=2.3]
  exec [label="Execute steps\ndeterministic", fillcolor="#F7ECF8", color="#6A2E6E", width=1.9]
  rej  [label="Rejected\nnaming the step", fillcolor="#FCECEC", color="#A62C2C", width=1.9]

  goal -> plan -> comp -> val -> exec
  val -> rej [color="#A62C2C", style=dashed, arrowsize=0.55]
  exec -> plan [color="#0D6E69", style=dashed, label=" replan re-enters\n the compiler",
                fontsize=9, fontcolor="#0D6E69", constraint=false]
}
