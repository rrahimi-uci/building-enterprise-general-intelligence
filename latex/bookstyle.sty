% The caption text already carries the book's own chapter-relative number
% ("Figure 4-1 — ..."), which the prose cross-references. LaTeX's automatic
% "Figure N:" label would print a second, different number in front of it, so
% the label is suppressed and the book's numbering stands alone.
% Tall portrait diagrams are height-limited, so the cap sets their label size:
% at 0.76\textheight a 12in-tall flow printed its labels near 6pt. 0.86 still
% leaves room for a two-line caption on a float page.
\newcommand{\BookDiagram}[3]{%
  \begin{figure}[htbp]\centering
  \includegraphics[width=\linewidth,height=0.86\textheight,keepaspectratio]{#1}%
  \captionsetup{labelformat=empty}\caption{#2}\label{fig:#3}
  \end{figure}}
\newcommand{\BookFigureCaption}[1]{\begin{center}\color{BookSlate}\fontsize{8.5}{10.5}\selectfont\itshape #1\end{center}}

% Tables.
\newcolumntype{Y}[1]{>{\RaggedRight\arraybackslash\hspace{0pt}}p{#1}}
\setlength{\tabcolsep}{4pt}
\setlength{\arrayrulewidth}{0.35pt}
\arrayrulecolor{BookRule}
% Keep-together guard for headings, listings and short tables. \needspace (v1.3)
% only plants a cheap breakpoint that TeX takes later, when the page overfills;
% if a longtable has started by then, its output routine handles that break and
% prints a stray table head on the next page. \Needspace measures the page now
% and breaks now, so the decision cannot leak into a later table.
\newcommand{\BookNeedspace}[1]{\Needspace{#1}}
\newcommand{\BookTableStart}{\par\vspace{4pt}\begingroup\small\setlength{\LTpre}{2pt}\setlength{\LTpost}{5pt}}
\newcommand{\BookTableEnd}{\endgroup\par\vspace{2pt}}

% The bundled Liberation fonts do not contain the snake emoji. Keep the
% canonical Markdown/DOCX label as 🐍 and render an equivalent portable glyph in
% XeLaTeX without relying on a host emoji font.
\newcommand{\BookSnake}{%
  \raisebox{0.06em}{%
    \begingroup
    \setlength{\unitlength}{0.14em}%
    \begin{picture}(20,11)
      \color{BookTeal}
      \linethickness{1.8pt}%
      \qbezier(1,3)(4,9.5)(7,3)
      \qbezier(7,3)(10,-3.5)(13,3)
      \qbezier(13,3)(15.5,7)(17.5,4)
      \put(17.5,4){\circle*{3.6}}
      \color{BookLight}
      \put(18.2,4.5){\circle*{0.9}}
    \end{picture}%
    \endgroup
  }%
}

