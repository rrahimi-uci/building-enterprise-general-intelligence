// Figure 28-1 — Admission, bounded execution, and outcome-based operating feedback.
// Message: optimize scarce resources only after policy and safety gates, and
// measure the feedback loop by verified outcomes rather than token price.
digraph reliability_economics {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.30]
  node [width=2.25]

  request [label="Request\nworkload + deadline", fillcolor="#E7F5F3", color="#0D6E69"]
  admit [label="Admission\nrisk + budget", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.8, height=0.95]
  queue [label="Fair queue\ncapacity permits", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  execute [label="Bounded execution\nmodel · tools · human", fillcolor="#E7F5F3", color="#0D6E69"]
  verify [label="Verify outcome\nquality · safety · effect", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.9, height=0.95]
  success [label="Accepted result\nevidence recorded", fillcolor="#F7ECF8", color="#6A2E6E"]
  feedback [label="Usage and SLO\nfeedback", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  degrade [label="Safe degradation\ndefer · draft · route", fillcolor="#FFF4DF", color="#8A5600", style=filled]

  request -> admit
  admit -> queue [label="  admit  ", color="#0D6E69", fontcolor="#0D6E69"]
  admit -> degrade [label="  pressure  ", color="#8A5600", fontcolor="#8A5600", style=dashed]
  queue -> execute
  execute -> verify
  verify -> success [label="  pass  ", color="#0D6E69", fontcolor="#0D6E69"]
  verify -> degrade [label="  fail or budget  ", color="#A62C2C", fontcolor="#A62C2C", style=dashed]
  success -> feedback [style=dotted, color="#1450A3", fontcolor="#1450A3"]
  degrade -> feedback [style=dotted, color="#1450A3", fontcolor="#1450A3"]
  feedback -> admit [label="  tune permits and routes  ", color="#1450A3", fontcolor="#1450A3", style=dashed, constraint=false]
}
