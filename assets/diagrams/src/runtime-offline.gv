// Figure 25-2 — Runtime adaptation and offline improvement boundary.
// Message: the loop that may change behaviour inside a run and the loop that may
// change the system are different loops; runtime outcomes cross only as evidence.
digraph runtime_offline {
  rankdir = TB
  graph [ranksep=0.22, nodesep=0.26]
  compound = true
  node [width=2.1, height=0.44]

  subgraph cluster_runtime {
    label="  Runtime · bounded, inside one run  "; labeljust="l"; fontsize=12; fontcolor="#0D6E69"
    color="#0D6E69"; style="rounded"; margin=14; bgcolor="#F4FBFA"
    r1 [label="Use authorized context\nor drop optional context", fillcolor="#E7F5F3", color="#0D6E69"]
    r2 [label="Retry or fall back\nwithin budget", fillcolor="#E7F5F3", color="#0D6E69"]
    r3 [label="Stop, ask, or escalate", fillcolor="#E7F5F3", color="#0D6E69"]
    r1 -> r2 -> r3
  }
  subgraph cluster_offline {
    label="  Offline · governed, changes the system  "; labeljust="l"; fontsize=12; fontcolor="#1450A3"
    color="#1450A3"; style="rounded"; margin=14; bgcolor="#F6FAFE"
    o1 [label="Diagnose from traces", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    o2 [label="Propose change", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    o3 [label="Validate on held-out set", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    gate [label="Owner approval", fillcolor="#FFF4DF", color="#8A5600", shape=box, style="filled,rounded"]
    o4 [label="Release with rollback", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    o1 -> o2 -> o3 -> gate -> o4
  }
  r3 -> o1 [label="  evidence, not a change  ", lhead=cluster_offline, color="#8A5600", fontcolor="#8A5600", style=dashed]
}
