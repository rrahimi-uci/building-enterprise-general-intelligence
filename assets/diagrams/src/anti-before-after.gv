// Figure 17-1 — Autonomous monolith versus governed agentic architecture.
// Message: the failure is a responsibility boundary, not a model choice. The
// same capabilities, correctly separated, become operable.
digraph anti_before_after {
  rankdir = TB
  graph [ranksep=0.30, nodesep=0.26]
  node [width=1.6, fontsize=11.5]

  subgraph cluster_before {
    label="  Anti-pattern · the autonomous monolith  "; labeljust="l"; fontsize=12; fontcolor="#A62C2C"
    color="#A62C2C"; style="rounded"; margin=14; bgcolor="#FDF5F5"
    b1 [label="Agent decides,\nauthorizes and acts", fillcolor="#FCECEC", color="#A62C2C"]
    b2 [label="State in the\nconversation", fillcolor="#FCECEC", color="#A62C2C"]
    b3 [label="Effects with no\nreceipt", fillcolor="#FCECEC", color="#A62C2C"]
    b1 -> b2 -> b3 [style=invis]
  }
  subgraph cluster_after {
    label="  Governed · the same capabilities, separated  "; labeljust="l"; fontsize=12; fontcolor="#0D6E69"
    color="#0D6E69"; style="rounded"; margin=14; bgcolor="#F4FBFA"
    a1 [label="Agent proposes", fillcolor="#E7F5F3", color="#0D6E69"]
    a2 [label="Platform authorizes", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    a3 [label="Gateway commits\nonce, with a receipt", fillcolor="#EDF3FC", color="#1450A3", shape=cylinder, style=filled]
    a1 -> a2 -> a3
  }
  b2 -> a2 [label="  separate the decision\n  from the authority  ", color="#8A5600", fontcolor="#8A5600", style=dashed]
}
