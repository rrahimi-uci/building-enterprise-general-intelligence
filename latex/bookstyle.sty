\newcommand{\BookFrontChapter}[1]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}%
  {\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #1\par}\vspace{7pt}%
  \markboth{#1}{#1}}

\newcommand{\BookChapter}[2]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{#1 — #2}%
  {\color{BookCyan}\fontsize{10}{12}\selectfont\bfseries\MakeUppercase{CHAPTER #1}\par}%
  \vspace{4pt}{\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #2\par}%
  \vspace{7pt}\markboth{#1 — #2}{#1 — #2}}

\newcommand{\BookAppendix}[2]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{Appendix #1 — #2}%
  {\color{BookCyan}\fontsize{10}{12}\selectfont\bfseries APPENDIX #1\par}%
  \vspace{4pt}{\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #2\par}%
  \vspace{7pt}\markboth{Appendix #1 — #2}{Appendix #1 — #2}}

% #4 is the Part's artwork panel, or empty. The panel deliberately carries no
% Part identity of its own: the number and title are set here from the canonical
% Markdown, so they cannot disagree with the book's structure.
\newcommand{\BookPartPage}[4]{%
  \clearpage\pagecolor{BookNavy}\color{white}\thispagestyle{empty}%
  \phantomsection\addcontentsline{toc}{part}{Part #1 — #2}%
  \vspace*{\ifstrempty{#4}{0.20\textheight}{0.055\textheight}}%
  \begin{center}
    {\color{BookCyan}\fontsize{15}{18}\selectfont\bfseries PART #1\par}
    \vspace{16pt}
    {\color{white}\fontsize{28}{33}\selectfont\bfseries\MakeUppercase{#2}\par}
    \vspace{26pt}
    \begin{minipage}{0.78\textwidth}\centering\color[HTML]{D8E8F5}\fontsize{11}{16}\selectfont #3\end{minipage}
    \ifstrempty{#4}{}{%
      \vspace{26pt}\par
      % 4.8in holds the panel at 257 dpi, above the 255 dpi asset contract.
      \includegraphics[width=4.8in,keepaspectratio]{#4}%
    }%
  \end{center}
  \vfill\clearpage\nopagecolor\color{BookInk}\pagestyle{fancy}%
}

\newcommand{\BookCover}[1]{%
  \clearpage\newgeometry{margin=0pt}\thispagestyle{empty}%
  \noindent\includegraphics[width=\paperwidth,height=\paperheight]{#1}%
  \clearpage\restoregeometry}

\newcommand{\BookTitlePage}[4]{%
  \thispagestyle{empty}\vspace*{0.11\textheight}%
  {\color{BookCyan}\rule{1.15in}{4pt}\par}\vspace{18pt}%
  {\color{BookNavy}\fontsize{30}{35}\selectfont\bfseries #1\par}%
  \vspace{16pt}{\color{BookTeal}\fontsize{14}{18}\selectfont #2\par}%
  \vspace{28pt}{\color{BookInk}\fontsize{13}{16}\selectfont\bfseries #3\par}%
  \vfill
  \begin{tcolorbox}[enhanced,colback=BookLight,colframe=BookNavy,boxrule=0.7pt,arc=2pt,left=14pt,right=14pt,top=12pt,bottom=12pt]
    \color{BookInk}\fontsize{10.5}{15}\selectfont #4
  \end{tcolorbox}
  \vspace*{0.07\textheight}\clearpage}

% Callouts and evidence.
\newtcolorbox{bookcallout}[1][Architecture note]{enhanced,breakable,colback=BookPaleBlue,colframe=BookBlue,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt,before skip=7pt,after skip=7pt}
\newtcolorbox{bookcaution}[1][Caution]{enhanced,breakable,colback=BookPaleAmber,colframe=BookAmber,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt,before skip=7pt,after skip=7pt}
\newtcolorbox{bookthreat}[1][Threat]{enhanced,breakable,colback=BookPaleRed,colframe=BookRed,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt,before skip=7pt,after skip=7pt}
% One shared shape for every guidance box, so a new kind is a colour and a
% default title rather than another block of duplicated geometry.
\newtcolorbox{bookguidancebase}[3][]{enhanced,breakable,colback=#2,colframe=#3,
  coltitle=white,fonttitle=\bfseries\fontsize{8.4}{10}\selectfont,
  boxrule=0.7pt,arc=2pt,left=10pt,right=10pt,top=8pt,bottom=8pt,
  before skip=7pt,after skip=7pt,#1}
\newenvironment{bookbestpractice}[1][Best practice]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleTeal}{BookTeal}}{\end{bookguidancebase}}
\newenvironment{bookarchitecture}[1][Architecture guidance]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleBlue}{BookNavyTwo}}{\end{bookguidancebase}}
\newenvironment{bookdeveloper}[1][Developer guideline]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleIndigo}{BookBlue}}{\end{bookguidancebase}}
\newenvironment{bookproduction}[1][Production consideration]%
  {\begin{bookguidancebase}[title={#1}]{BookPalePlum}{BookPlum}}{\end{bookguidancebase}}
\newenvironment{booksecurity}[1][Security \& governance]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleRed}{BookRed}}{\end{bookguidancebase}}
\newenvironment{bookantipattern}[1][Common pitfall]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleAmber}{BookAmber}}{\end{bookguidancebase}}
\newenvironment{bookcost}[1][Performance \& cost]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleOlive}{BookOlive}}{\end{bookguidancebase}}
\newenvironment{bookobservability}[1][Observability tip]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleCyan}{BookDeepCyan}}{\end{bookguidancebase}}

