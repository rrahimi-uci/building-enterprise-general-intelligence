// Figure 24-1 — A causal run trace and a separate protected audit ledger.
// Message: traces explain distributed work; the audit ledger proves protected
// decisions and effects. Stable IDs and links survive queues and retries.
digraph causal_trace {
  rankdir = TB
  graph [ranksep=0.30, nodesep=0.60, compound=true]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.12,0.07", height=0.43, width=2.15]
  edge [arrowsize=0.65, penwidth=1.5, color="#1450A3"]

  run       [label="Run root\nstable run_id", fillcolor="#E7F5F3", color="#0D6E69"]
  admit     [label="Admission\nrelease + policy", fillcolor="#EAF3FB", color="#1450A3"]
  workflow  [label="Workflow task\ncheckpoint + task_id", fillcolor="#EAF3FB", color="#1450A3"]
  context   [label="Retrieval\nauthorized context", fillcolor="#E7F5F3", color="#0D6E69"]
  model     [label="Model turn\nroute + tokens", fillcolor="#E7F5F3", color="#0D6E69"]
  policy    [label="Policy decision\nreason + obligations", shape=diamond,
             style=filled, fillcolor="#FFF4DF", color="#8A5600", width=2.4, height=0.72]
  tool      [label="Tool / remote task\nspan link + effect key", fillcolor="#EAF3FB", color="#1450A3"]
  effect    [label="Effect outcome\nreceipt or Unknown", fillcolor="#F7ECF8", color="#6A2E6E"]
  outcome   [label="Accepted outcome\nuser + business record", fillcolor="#F7ECF8", color="#6A2E6E"]

  trace [label="Trace index\nredacted spans + causal links", shape=cylinder,
         style=filled, fillcolor="#EDF3FC", color="#1450A3", width=2.35]
  audit [label="Audit ledger\ncomplete protected events", shape=cylinder,
        style=filled, fillcolor="#F7ECF8", color="#6A2E6E", width=2.35]
  vault [label="Content vault\ncontrolled payload handles", shape=cylinder,
        style=filled, fillcolor="#EEF4FA", color="#0B6076", width=2.35]

  run -> admit -> workflow -> context -> model -> policy -> tool -> effect -> outcome
  workflow -> tool [label="queue / resume", style=dashed, color="#1450A3",
                    fontcolor="#1450A3", constraint=false]

  run -> trace [style=dotted, color="#1450A3", constraint=false]
  workflow -> trace [style=dotted, color="#1450A3", constraint=false]
  model -> trace [style=dotted, color="#1450A3", constraint=false]
  tool -> trace [style=dotted, color="#1450A3", constraint=false]
  policy -> audit [style=dotted, color="#6A2E6E", constraint=false]
  effect -> audit [style=dotted, color="#6A2E6E", constraint=false]
  context -> vault [style=dotted, color="#0B6076", constraint=false]
  model -> vault [style=dotted, color="#0B6076", constraint=false]

  // Each store sits beside the stretch of the run that writes to it, so the
  // evidence edges run sideways instead of crossing the whole figure. With
  // all three stores in one top row, eight dotted edges tangled over the run.
  { rank=same; workflow; trace }
  { rank=same; model; vault }
  { rank=same; tool; audit }
}
