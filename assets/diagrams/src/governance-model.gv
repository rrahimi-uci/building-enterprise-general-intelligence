// Figure 26-1 — Federated governance with centralized control services.
// Message: decisions stay close to the domain; the evidence, policy and identity
// they depend on are shared, so governance accelerates rather than gates.
digraph governance_model {
  rankdir = TB
  graph [ranksep=0.42, nodesep=0.26]
  node [width=1.65, fontsize=12]

  subgraph cluster_central {
    label="  Central control services · built once  "; labeljust="l"; fontsize=12; fontcolor="#1450A3"
    color="#1450A3"; style="rounded"; margin=14; bgcolor="#F6FAFE"
    c1 [label="Identity and\npolicy", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    c2 [label="Evidence and\naudit", fillcolor="#EAF3FB", color="#1450A3", style=filled]
    c3 [label="Risk tiers and\nexceptions", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  }
  subgraph cluster_domains {
    label="  Domain teams · decide in context  "; labeljust="l"; fontsize=12; fontcolor="#0D6E69"
    color="#0D6E69"; style="rounded"; margin=14; bgcolor="#F4FBFA"
    d1 [label="Mortgage evidence\nagents", fillcolor="#E7F5F3", color="#0D6E69"]
    d2 [label="Supply chain\nagents", fillcolor="#E7F5F3", color="#0D6E69"]
    d3 [label="Service\nagents", fillcolor="#E7F5F3", color="#0D6E69"]
  }
  board [label="Review board · proportional to risk tier, not to team", fillcolor="#FFF4DF", color="#8A5600", style=filled, width=4.4]

  c1 -> d1 [label="  grants  "]
  c2 -> d2 [label="  evidence  "]
  c3 -> d3 [label="  thresholds  "]
  d2 -> board [label="  high-risk only  ", color="#8A5600", fontcolor="#8A5600", style=dashed]
}
