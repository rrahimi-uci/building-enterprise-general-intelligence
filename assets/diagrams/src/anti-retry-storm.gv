// Figure 17-3 — AP-04 and AP-05, which compound.
// Message: layered retries multiply attempts, and treating a timeout as failure turns the last attempt into a duplicate effect.
//
// Layout: two labelled columns rather than two clusters. A top-level
// `rank=same` naming nodes that live inside clusters makes dot drop the cluster
// boxes entirely, so each panel is a rank=same group with its heading as a
// plain node and its flow edges unconstrained. With rankdir=LR a rank becomes a
// column, which is why this reads top-to-bottom within each panel. The heading
// lands at the foot of its column -- dot orders within a rank by edge
// structure, not by the order names are listed -- so it reads as a caption.
// That is deliberate; do not spend time trying to move it.
digraph anti_retry_storm {
  rankdir = LR
  graph [ranksep=0.30, nodesep=0.18]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=11,
        margin="0.13,0.08", height=0.40]
  edge [arrowsize=0.7, penwidth=1.6]

  bad  [shape=plaintext, style="", label=<<B><FONT COLOR="#A62C2C" POINT-SIZE="12">ANTI&#8209;PATTERN</FONT></B>>]
  good [shape=plaintext, style="", label=<<B><FONT COLOR="#0D6E69" POINT-SIZE="12">CORRECTION</FONT></B>>]
  bad -> good [style=invis]


  b1 [label="Workflow ×2", shape=box, style="filled,rounded", fillcolor="#E7F5F3", color="#0D6E69"]
  b2 [label="Gateway ×3", shape=box, style="filled,rounded", fillcolor="#EAF3FB", color="#1450A3"]
  b3 [label="HTTP client ×3", shape=box, style="filled,rounded", fillcolor="#EEF4FA", color="#4A6078"]
  b4 [label="Registry\n18 calls", shape=cylinder, style=filled, fillcolor="#FBE3E3", color="#A62C2C"]
  b5 [label="Timeout → failed → retry\nvendor created twice", shape=box, style="filled,rounded", fillcolor="#FBE3E3", color="#A62C2C"]
  g1 [label="Classify failure", shape=diamond, style=filled, fillcolor="#FFF4DF", color="#8A5600", height=0.62]
  g2 [label="Workflow owns retry\nshared budget", shape=box, style="filled,rounded", fillcolor="#E7F5F3", color="#0D6E69"]
  g3 [label="Gateway ×0\nclient ×0", shape=box, style="filled,rounded", fillcolor="#EEF4FA", color="#4A6078"]
  g4 [label="Unknown effect\nblocks retry", shape=box, style="filled,rounded", fillcolor="#FFF4DF", color="#8A5600"]
  g5 [label="Reconcile against\nsystem of record", shape=cylinder, style=filled, fillcolor="#F7ECF8", color="#6A2E6E"]

  b1 -> b2 [color="#A62C2C", constraint=false]
  b2 -> b3 [color="#A62C2C", constraint=false]
  b3 -> b4 [color="#A62C2C", constraint=false]
  b4 -> b5 [color="#A62C2C", constraint=false]
  g1 -> g2 [color="#0D6E69", constraint=false, xlabel=" transient"]
  g2 -> g3 [color="#0D6E69", constraint=false]
  g3 -> g4 [color="#0D6E69", constraint=false, xlabel=" unknown"]
  g4 -> g5 [color="#0D6E69", constraint=false]

  { rank=same; b1; b2; b3; b4; b5; bad }
  { rank=same; g1; g2; g3; g4; g5; good }
}
