\newtcolorbox{bookcallout}[1][Architecture note]{enhanced,breakable,colback=BookPaleBlue,colframe=BookBlue,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=6pt,after skip=6pt}
\newtcolorbox{bookcaution}[1][Caution]{enhanced,breakable,colback=BookPaleAmber,colframe=BookAmber,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=6pt,after skip=6pt}
\newtcolorbox{bookthreat}[1][Threat]{enhanced,breakable,colback=BookPaleRed,colframe=BookRed,coltitle=white,fonttitle=\bfseries,title=#1,boxrule=0.7pt,arc=2pt,left=9pt,right=9pt,top=6pt,bottom=6pt,before skip=6pt,after skip=6pt}
% One shared shape for every guidance box, so a new kind is a colour and a
% default title rather than another block of duplicated geometry.
\newtcolorbox{bookguidancebase}[3][]{enhanced,breakable,colback=#2,colframe=#3,
  coltitle=white,fonttitle=\bfseries\fontsize{8.4}{10}\selectfont,
  boxrule=0.7pt,arc=2pt,left=9pt,right=9pt,top=6pt,bottom=6pt,
  before skip=6pt,after skip=6pt,#1}
\newenvironment{bookbestpractice}[1][Best practice]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleTeal}{BookTeal}}{\end{bookguidancebase}}
\newenvironment{bookarchitecture}[1][Architecture guidance]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleBlue}{BookNavyTwo}}{\end{bookguidancebase}}
\newenvironment{bookdeveloper}[1][Developer guideline]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleIndigo}{BookBlue}}{\end{bookguidancebase}}
\newenvironment{bookproduction}[1][Production consideration]%
  {\begin{bookguidancebase}[title={#1}]{BookPalePlum}{BookPlum}}{\end{bookguidancebase}}
\newenvironment{booksecurity}[1][Security \& governance]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleRed}{BookRed}}{\end{bookguidancebase}}
\newenvironment{bookantipattern}[1][Common pitfall]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleAmber}{BookAmber}}{\end{bookguidancebase}}
\newenvironment{bookcost}[1][Performance \& cost]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleOlive}{BookOlive}}{\end{bookguidancebase}}
\newenvironment{bookobservability}[1][Observability tip]%
  {\begin{bookguidancebase}[title={#1}]{BookPaleCyan}{BookDeepCyan}}{\end{bookguidancebase}}

