// Figure 6-1 — The context build pipeline.
//
// Message: the order is the security property. Authorization sits at stage
// three, before any content is fetched, and only the last boundary turns
// references into bytes. Everything between moves references, which is what
// keeps the ContextManifest an accurate record of what the model actually saw.
//
// Layout: vertical, with the two load-bearing stages called out on the right.
// Ten stages side by side renders as an unreadable strip at book width.
digraph context_pipeline {
  rankdir = TB
  graph [ranksep=0.16, nodesep=0.34]
  node [shape=box, style="filled,rounded", penwidth=1.35, fontsize=10.5,
        margin="0.12,0.06", height=0.38, width=2.15]
  edge [arrowsize=0.6, penwidth=1.45, color="#1450A3"]

  s1  [label="1 · Parse request",        fillcolor="#EEF4FA", color="#4A6078"]
  s2  [label="2 · Candidate sources",    fillcolor="#E6F5F9", color="#0B6076"]
  s3  [label="3 · Authorize",            fillcolor="#FCECEC", color="#A62C2C", penwidth=2.0]
  s4  [label="4 · Fetch pinned versions",fillcolor="#E6F5F9", color="#0B6076"]
  s5  [label="5 · Classify and sanitize",fillcolor="#E6F5F9", color="#0B6076"]
  s6  [label="6 · Deduplicate",          fillcolor="#E6F5F9", color="#0B6076"]
  s7  [label="7 · Rank",                 fillcolor="#E6F5F9", color="#0B6076"]
  s8  [label="8 · Allocate tokens",      fillcolor="#E6F5F9", color="#0B6076"]
  s9  [label="9 · Ordered references",   fillcolor="#EAF3FB", color="#1450A3"]
  s10 [label="10 · ContextManifest",     shape=note, style=filled,
       fillcolor="#FFF4DF", color="#8A5600"]
  mdl [label="model request", fillcolor="#E7F5F3", color="#0D6E69"]

  n3 [label="before a single byte\nis fetched", shape=plaintext, style="",
      fontsize=9.5, fontcolor="#A62C2C"]
  n9 [label="references only —\nno content yet", shape=plaintext, style="",
      fontsize=9.5, fontcolor="#4A6078"]
  nm [label="the only boundary that\nmaterializes bytes", shape=plaintext, style="",
      fontsize=9.5, fontcolor="#0D6E69"]
  blank1 [style=invis, label="", width=0.01, height=0.01]

  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> s9 -> s10 -> mdl

  { rank=same; s3  -> n3 [style=invis] }
  { rank=same; s9  -> n9 [style=invis] }
  { rank=same; mdl -> nm [style=invis] }
  { rank=same; s1  -> blank1 [style=invis] }
}
