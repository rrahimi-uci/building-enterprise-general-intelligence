\newcommand{\BookFrontChapter}[1]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{#1}%
  {\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #1\par}\vspace{7pt}%
  \markboth{#1}{#1}}

\newcommand{\BookChapter}[2]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{#1 — #2}%
  {\color{BookCyan}\fontsize{10}{12}\selectfont\bfseries\MakeUppercase{CHAPTER #1}\par}%
  \vspace{4pt}{\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #2\par}%
  \vspace{7pt}\markboth{#1 — #2}{#1 — #2}}

\newcommand{\BookAppendix}[2]{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{Appendix #1 — #2}%
  {\color{BookCyan}\fontsize{10}{12}\selectfont\bfseries APPENDIX #1\par}%
  \vspace{4pt}{\color{BookNavy}\fontsize{24}{28}\selectfont\bfseries #2\par}%
  \vspace{7pt}\markboth{Appendix #1 — #2}{Appendix #1 — #2}}

% The Part number and title are set here from the canonical Markdown, so they
% cannot disagree with the book's structure. The page carries no artwork.
\newcommand{\BookPartPage}[3]{%
  \clearpage\pagecolor{BookNavy}\color{white}\thispagestyle{empty}%
  \phantomsection\addcontentsline{toc}{part}{Part #1 — #2}%
  \vspace*{0.20\textheight}%
  \begin{center}
    {\color{BookCyan}\fontsize{15}{18}\selectfont\bfseries PART #1\par}
    \vspace{16pt}
    {\color{white}\fontsize{28}{33}\selectfont\bfseries\MakeUppercase{#2}\par}
    \vspace{26pt}
    \begin{minipage}{0.78\textwidth}\raggedright\setlength{\parskip}{8pt}\let\BookPartBold\textbf\renewcommand{\textbf}[1]{{\color{white}\BookPartBold{##1}}}\color[HTML]{D8E8F5}\fontsize{11}{16}\selectfont #3\end{minipage}
  \end{center}
  \vfill\clearpage\nopagecolor\color{BookInk}\pagestyle{fancy}%
}

\newcommand{\BookCover}[1]{%
  \clearpage\newgeometry{margin=0pt}\thispagestyle{empty}%
  \noindent\includegraphics[width=\paperwidth,height=\paperheight]{#1}%
  \clearpage\restoregeometry}

% A full-bleed Letter chapter cover. It stands alone on the page before the
% chapter's own opening page, exactly as the Part divider does.
% The image is placed on the page with an overlay rather than by switching the
% page geometry: \newgeometry forces its own page break, which left a blank page
% in front of every cover. This one \clearpage-to-\clearpage page holds only the
% image and nothing else.
\newcommand{\BookChapterCover}[1]{%
  \clearpage\thispagestyle{empty}\null
  \begin{tikzpicture}[remember picture,overlay]
    \node[inner sep=0pt,anchor=center] at (current page.center)
      {\includegraphics[width=\paperwidth,height=\paperheight]{#1}};
  \end{tikzpicture}%
  \clearpage}

\newcommand{\BookTitlePage}[4]{%
  \thispagestyle{empty}\vspace*{0.11\textheight}%
  {\color{BookCyan}\rule{1.15in}{4pt}\par}\vspace{18pt}%
  {\color{BookNavy}\fontsize{30}{35}\selectfont\bfseries #1\par}%
  \vspace{16pt}{\color{BookTeal}\fontsize{14}{18}\selectfont #2\par}%
  \vspace{28pt}{\color{BookInk}\fontsize{13}{16}\selectfont\bfseries #3\par}%
  \vfill
  \begin{tcolorbox}[enhanced,colback=BookLight,colframe=BookNavy,boxrule=0.7pt,arc=2pt,left=14pt,right=14pt,top=12pt,bottom=12pt]
    \color{BookInk}\fontsize{10.5}{15}\selectfont #4
  \end{tcolorbox}
  \vspace*{0.07\textheight}\clearpage}

