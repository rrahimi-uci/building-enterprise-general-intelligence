// Figure 7-2 — Platform contracts with replaceable framework and provider adapters.
// Message: the contracts are the asset. Frameworks and providers sit behind
// adapters, so replacing one is an adapter change, not a rewrite.
digraph portability {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.26, compound=true]
  node [width=1.45, fontsize=11.5]

  app [label="Application code", fillcolor="#F7ECF8", color="#6A2E6E", width=2.4]
  contracts [label="Platform contracts\nAgentSpec · AgentStepRequest · ToolManifest",
             fillcolor="#EAF3FB", color="#1450A3", style=filled, width=3.2]

  subgraph cluster_frameworks {
    label="  Framework adapters  "; labeljust="l"; fontsize=11.5; fontcolor="#0D6E69"
    color="#0D6E69"; style="rounded,dashed"; margin=12; bgcolor="#F4FBFA"
    f1 [label="Agents SDK", fillcolor="#E7F5F3", color="#0D6E69"]
    f2 [label="Graph runner", fillcolor="#E7F5F3", color="#0D6E69"]
    { rank=same; f1 -> f2 [label=" or ", style=dotted, arrowhead=none, color="#0D6E69", fontcolor="#0D6E69"] }
  }
  subgraph cluster_providers {
    label="  Provider adapters  "; labeljust="l"; fontsize=11.5; fontcolor="#8A5600"
    color="#8A5600"; style="rounded,dashed"; margin=12; bgcolor="#FFFCF5"
    p1 [label="Model A", fillcolor="#FFF4DF", color="#8A5600"]
    p2 [label="Model B", fillcolor="#FFF4DF", color="#8A5600"]
    { rank=same; p1 -> p2 [label=" or ", style=dotted, arrowhead=none, color="#8A5600", fontcolor="#8A5600"] }
  }

  app -> contracts [label="  the only dependency  "]
  // The edges land on the cluster, not one member: either adapter in it can
  // sit behind the contract. A rank=same set outside the clusters made dot
  // delete both clusters, which left two unexplained, unconnected boxes.
  contracts -> f1 [label="  swap  ", style=dashed, lhead=cluster_frameworks]
  contracts -> p1 [label="  swap  ", style=dashed, lhead=cluster_providers]
}
