// Figure 5-3 — Document ingestion: intake, extract, verify against the bytes,
// route, record, serve.
// Message: a document's text and fields are projections of pinned bytes;
// verification re-opens the bytes instead of trusting the extraction; and only
// supported facts reach the enforced rule. The gate reuses Figure 5-2's shape so
// the reader sees one discipline in two lanes.
digraph document_ingestion {
  rankdir = TB
  graph [ranksep=0.26, nodesep=0.25]
  edge [fontsize=12.5]

  doc [label="Source document\nPAY-000184-02\nbytes + digest",
       shape=note, style=filled, fillcolor="#E6F5F9", color="#0B6076"]
  intake [label="Intake\nscan · classify · ACL\nlabel as data",
          fillcolor="#EAF3FB", color="#1450A3", style=filled]
  extract [label="Extract and normalize\nmodel proposes fields with\nregion · unit · confidence\nextractor version",
           fillcolor="#E7F5F3", color="#0D6E69"]
  verify [label="Literal span\nin the bytes?\nConsistent?",
          shape=diamond, style=filled, fillcolor="#FFF4DF", color="#8A5600",
          height=1.35, width=2.3, margin="0.02,0.02"]
  record [label="KnowledgeArtifact\ndigest · regions · verdicts\nversions: diff, not overwrite",
          shape=cylinder, style=filled, fillcolor="#EDF3FC", color="#1450A3"]
  route [label="Route by\nfinding kind",
         shape=diamond, style=filled, fillcolor="#FFF4DF", color="#8A5600",
         height=1.0, width=1.9, margin="0.02,0.02"]
  semantic [label="Semantic view\nfor the Retrieval\nBroker (Ch 6)",
            fillcolor="#EAF3FB", color="#1450A3", style=filled]
  rule [label="Enforced rule\nsupported\nfacts only",
        fillcolor="#F7ECF8", color="#6A2E6E"]
  reject [label="Not served\ncontradicted or\nunverifiable", fillcolor="#FCECEC", color="#A62C2C"]

  doc -> intake [label="  bytes  "]
  intake -> extract [label="  text + structure  "]
  extract -> verify [label="  candidate fields  "]
  verify:w -> doc:s [style=dotted, color="#0B6076", fontcolor="#0B6076",
                 label="re-opens the\npinned bytes  ", constraint=false]
  verify -> record [label="supported  ", color="#0D6E69", fontcolor="#0D6E69"]
  verify -> route [label="  contradicted or\n  insufficient", color="#A62C2C", fontcolor="#A62C2C"]
  route:e -> extract:e [style=dashed, label="  repair\n  one field", constraint=false]
  route -> reject [label="  human review or\n  case management"]
  record -> semantic [label="text as data  "]
  record -> rule [label="  facts"]

  { rank=same; doc; intake }
  { rank=same; record; route }
  record -> route [style=invis]
  { rank=same; semantic; rule; reject }
  semantic -> rule -> reject [style=invis]
}
