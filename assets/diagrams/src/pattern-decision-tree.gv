// Figure 16-1 — Pattern selection decision tree.
// Message: choose by hidden obligation, uncertainty and risk, not by fashionable
// terminology. Each leaf names the pattern and the condition that reached it.
digraph pattern_decision_tree {
  rankdir = TB
  graph [ranksep=0.32, nodesep=0.14]
  node [width=1.35, fontsize=10.5]
  edge [fontsize=9.5]

  q1 [label="Path known\nin advance?", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.5, height=0.85]
  q2 [label="Next step depends\non observation?", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.8, height=0.85]
  q3 [label="Long-running?", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.5, height=0.85]
  q4 [label="Effect needs\nhuman authority?", fillcolor="#FFF4DF", color="#8A5600", shape=diamond, style=filled, width=1.7, height=0.85]

  p1 [label="Deterministic\nworkflow", fillcolor="#E7F5F3", color="#0D6E69"]
  p2 [label="Bounded\nReAct", fillcolor="#E7F5F3", color="#0D6E69"]
  p3 [label="Plan–Execute", fillcolor="#E7F5F3", color="#0D6E69"]
  p4 [label="Durable\nagent", fillcolor="#E7F5F3", color="#0D6E69"]
  p5 [label="Human-in-\nthe-loop", fillcolor="#E7F5F3", color="#0D6E69"]

  q1 -> p1 [label=" yes ", color="#0D6E69", fontcolor="#0D6E69"]
  q1 -> q2 [label=" no "]
  q2 -> p2 [label=" yes ", color="#0D6E69", fontcolor="#0D6E69"]
  q2 -> p3 [label=" no "]
  q2 -> q3 [style=dashed, color="#4A6078", label=" then "]
  q3 -> p4 [label=" yes ", color="#0D6E69", fontcolor="#0D6E69"]
  q3 -> q4 [label=" no "]
  q4 -> p5 [label=" yes ", color="#0D6E69", fontcolor="#0D6E69"]
}
