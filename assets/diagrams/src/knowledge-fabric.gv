// Figure 5-1 — The enterprise knowledge fabric and its four consumption modes.
// Message: RAG is one representation among several, and one governed surface
// sits between all of them and the agent.
digraph knowledge_fabric {
  rankdir = TB
  graph [ranksep=0.32, nodesep=0.22]
  node [shape=plaintext, style="", margin=0]
  edge [arrowsize=0.7]

  gov [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#8A5600" BGCOLOR="#FFF4DF">
      <TR><TD ALIGN="CENTER" WIDTH="470"><B>Governance</B>  ·  owner · version · effective dates · provenance · permissions</TD></TR>
    </TABLE>>]

  reps [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#1450A3" BGCOLOR="white">
      <TR>
        <TD WIDTH="118" BGCOLOR="#EAF3FB" ALIGN="CENTER">Semantic index<BR/><FONT POINT-SIZE="10" COLOR="#4A6078">RAG</FONT></TD>
        <TD WIDTH="118" BGCOLOR="#E6F5F9" ALIGN="CENTER">Ontology<BR/><FONT POINT-SIZE="10" COLOR="#4A6078">and graph</FONT></TD>
        <TD WIDTH="118" BGCOLOR="#FCECEC" ALIGN="CENTER">Rules<BR/><FONT POINT-SIZE="10" COLOR="#4A6078">SBVR · DMN</FONT></TD>
        <TD WIDTH="118" BGCOLOR="#F7ECF8" ALIGN="CENTER">Catalogs<BR/><FONT POINT-SIZE="10" COLOR="#4A6078">data · capability</FONT></TD>
      </TR>
    </TABLE>>]

  api [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#1450A3" BGCOLOR="#EAF3FB">
      <TR><TD ALIGN="CENTER" WIDTH="470"><B>Knowledge resolution API</B>  ·  one surface, permissions enforced here</TD></TR>
    </TABLE>>]

  modes [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#0D6E69" BGCOLOR="#E7F5F3">
      <TR>
        <TD WIDTH="118" ALIGN="CENTER"><B>Context</B><BR/><FONT POINT-SIZE="10" COLOR="#4A6078">what is the situation</FONT></TD>
        <TD WIDTH="118" ALIGN="CENTER"><B>Reasoning</B><BR/><FONT POINT-SIZE="10" COLOR="#4A6078">what should happen</FONT></TD>
        <TD WIDTH="118" ALIGN="CENTER"><B>Constraints</B><BR/><FONT POINT-SIZE="10" COLOR="#4A6078">what may I do</FONT></TD>
        <TD WIDTH="118" ALIGN="CENTER"><B>Action</B><BR/><FONT POINT-SIZE="10" COLOR="#4A6078">how do I do it</FONT></TD>
      </TR>
    </TABLE>>]

  agent [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0D6E69" BGCOLOR="#E7F5F3">
      <TR><TD ALIGN="CENTER" WIDTH="470"><B>Agent runtime</B></TD></TR>
    </TABLE>>]

  gov -> reps [style=dashed, color="#8A5600", label="  governs  ", fontcolor="#8A5600"]
  reps -> api
  api -> modes
  modes -> agent
}
