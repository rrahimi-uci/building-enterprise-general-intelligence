// Figure 7-1 — Agentic developer platform and SDK capability stack.
// Message: teams build differentiated agents on shared, versioned capabilities
// they do not have to re-implement or re-secure. Skills and Skill Packs are
// domain-owned and reused across agents; the registry that resolves them is
// platform-owned.
digraph developer_platform {
  rankdir = TB
  graph [ranksep=0.16]
  node [shape=plaintext, style="", margin=0]
  edge [style=invis]

  apps [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#6A2E6E" BGCOLOR="#F7ECF8">
      <TR><TD COLSPAN="4" BGCOLOR="#6A2E6E" ALIGN="LEFT"><FONT COLOR="white"><B>  Team-owned · differentiated</B></FONT></TD></TR>
      <TR><TD WIDTH="118" ALIGN="CENTER">Domain agents</TD><TD WIDTH="118" ALIGN="CENTER">Domain tools</TD>
          <TD WIDTH="118" ALIGN="CENTER">Skills · Skill Packs<BR/><FONT POINT-SIZE="10">domain-owned</FONT></TD><TD WIDTH="118" ALIGN="CENTER">Eval datasets</TD></TR>
    </TABLE>>]
  sdk [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#0D6E69" BGCOLOR="#E7F5F3">
      <TR><TD COLSPAN="4" BGCOLOR="#0D6E69" ALIGN="LEFT"><FONT COLOR="white"><B>  SDK · portable contracts</B></FONT></TD></TR>
      <TR><TD WIDTH="118" ALIGN="CENTER">AgentSpec</TD><TD WIDTH="118" ALIGN="CENTER">ToolManifest</TD>
          <TD WIDTH="118" ALIGN="CENTER">AgentStepRequest</TD><TD WIDTH="118" ALIGN="CENTER">ContextManifest</TD></TR>
    </TABLE>>]
  platform [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#1450A3" BGCOLOR="#EAF3FB">
      <TR><TD COLSPAN="4" BGCOLOR="#1450A3" ALIGN="LEFT"><FONT COLOR="white"><B>  Platform · shared and operated</B></FONT></TD></TR>
      <TR><TD WIDTH="118" ALIGN="CENTER">Run service</TD><TD WIDTH="118" ALIGN="CENTER">Tool Gateway</TD>
          <TD WIDTH="118" ALIGN="CENTER">LLM Gateway</TD><TD WIDTH="118" ALIGN="CENTER">Skill registry</TD></TR>
    </TABLE>>]
  control [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#A62C2C" BGCOLOR="#FCECEC">
      <TR><TD COLSPAN="4" BGCOLOR="#A62C2C" ALIGN="LEFT"><FONT COLOR="white"><B>  Control · never re-implemented by a team</B></FONT></TD></TR>
      <TR><TD WIDTH="118" ALIGN="CENTER">Identity</TD><TD WIDTH="118" ALIGN="CENTER">Policy</TD>
          <TD WIDTH="118" ALIGN="CENTER">Evidence</TD><TD WIDTH="118" ALIGN="CENTER">Tracing</TD></TR>
    </TABLE>>]
  apps -> sdk -> platform -> control
}
