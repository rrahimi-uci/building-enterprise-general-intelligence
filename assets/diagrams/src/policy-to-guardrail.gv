// Figure 5-2 — Extract, prove, approve, project.
// Message: extraction is probabilistic and verification is not, so the gate in
// the middle is the load-bearing part. Ungrounded claims leave the pipeline, and
// an accountable owner approves the interpretation before it is enforced.
// The policy sentence is the chapter's own example (a pay-statement age window),
// not an unrelated payments rule.
digraph policy_to_guardrail {
  rankdir = TB
  graph [ranksep=0.30, nodesep=0.35]

  policy [label="Policy text\n\n\"A pay statement is acceptable\nonly within the age window\"",
          fillcolor="#EEF4FA", color="#4A6078", shape=note, style=filled]
  extract [label="Extract\ntyped rule, scope, citation", fillcolor="#E7F5F3", color="#0D6E69"]
  prove [label="Grounded in\nthe corpus?", fillcolor="#FFF4DF", color="#8A5600", shape=diamond,
         style=filled, height=1.1, width=2.0]
  reject [label="Rejected\ncitation not supported", fillcolor="#FCECEC", color="#A62C2C"]
  approve [label="Approve\neligible owner accepts", fillcolor="#FFF4DF", color="#8A5600"]
  project [label="Project\nDMN · graph · rule", fillcolor="#EAF3FB", color="#1450A3", style=filled]
  guard [label="Enforced rule at the\neffect boundary", fillcolor="#FCECEC", color="#A62C2C", style=filled]
  action [label="Governed action", fillcolor="#F7ECF8", color="#6A2E6E"]

  policy -> extract [label="  language model  "]
  extract -> prove [label="  claim + citation  "]
  prove -> reject [label="  no  ", color="#A62C2C", fontcolor="#A62C2C"]
  prove -> approve [label="  yes  ", color="#0D6E69", fontcolor="#0D6E69"]
  approve -> project [label="  rule version recorded  "]
  project -> guard [label="  enforceable  "]
  guard -> action [label="  permitted  "]

  { rank=same; prove; reject }
}
