// Figure 7-3 — Developer golden path from scaffold to operated release.
// Message: one supported route, with the platform supplying identity, versions
// and evidence at each step so a team never assembles them by hand.
digraph dx_golden_path {
  rankdir = TB
  graph [ranksep=0.32, nodesep=0.22]
  node [width=1.15, fontsize=12]

  subgraph cluster_path {
    label="  Golden path"; labeljust="l"; fontsize=12; fontcolor="#4A6078"
    color="#B9C8D8"; style="rounded"; margin=14
    s1 [label="Scaffold", fillcolor="#E7F5F3", color="#0D6E69"]
    s2 [label="Develop", fillcolor="#E7F5F3", color="#0D6E69"]
    s3 [label="Debug", fillcolor="#E7F5F3", color="#0D6E69"]
    s4 [label="Evaluate", fillcolor="#E7F5F3", color="#0D6E69"]
    s5 [label="Package", fillcolor="#E7F5F3", color="#0D6E69"]
    s6 [label="Promote", fillcolor="#E7F5F3", color="#0D6E69"]
    s7 [label="Operate", fillcolor="#E7F5F3", color="#0D6E69"]
    s8 [label="Improve", fillcolor="#E7F5F3", color="#0D6E69"]
    { rank=same; s1 -> s2 -> s3 -> s4 }
    { rank=same; s8 -> s7 -> s6 -> s5 [dir=back] }
    s4 -> s5
  }

  supplied [label="Supplied by the platform, never assembled by hand:\nidentity · tool manifests · pinned versions · traces · evidence",
            fillcolor="#EAF3FB", color="#1450A3", style=filled, shape=note, fontsize=12]
  s6 -> supplied [style=invis]
  s7 -> supplied [style=dashed, color="#1450A3", dir=back, constraint=false]
  s5 -> supplied [style=dashed, color="#1450A3", dir=back, constraint=false]
  s6 -> supplied [style=dashed, color="#1450A3", dir=back, constraint=false]
}
