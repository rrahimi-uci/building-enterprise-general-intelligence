// Figure 10-1 — Bounded ReAct. The loop is inside; the limits are outside.
// Message: reason-act-observe cycles, but the controller that owns budgets,
// no-progress detection and termination is not in the loop. A mutation never
// executes inside it -- it leaves as a proposal.
digraph pattern_react {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.26]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.12,0.07", height=0.40, width=1.5]
  edge [arrowsize=0.65, penwidth=1.5, color="#0D6E69"]

  ctl [label="Controller\nturns · time · cost · no-progress", fillcolor="#EAF3FB",
       color="#1450A3", width=2.5]
  rea [label="Reason", fillcolor="#E7F5F3", color="#0D6E69"]
  act [label="Act\n(read tools only)", fillcolor="#E6F5F9", color="#0B6076"]
  obs [label="Observe\ntyped · provenance", fillcolor="#E6F5F9", color="#0B6076"]
  acc [label="Acceptance engine", fillcolor="#FFF4DF", color="#8A5600", width=1.9]
  pro [label="Proposed effect\nleaves the loop", fillcolor="#F7ECF8", color="#6A2E6E", width=1.9]

  rea -> act -> obs
  obs -> rea [label=" next need", fontsize=9, fontcolor="#4A6078"]
  ctl -> rea [color="#1450A3", style=dashed, arrowsize=0.55, label=" admits each turn",
              fontsize=9, fontcolor="#1450A3"]
  obs -> acc [color="#8A5600", label=" stop?", fontsize=9, fontcolor="#8A5600"]
  rea -> pro [color="#6A2E6E", style=dashed, label=" mutation", fontsize=9, fontcolor="#6A2E6E"]
}
