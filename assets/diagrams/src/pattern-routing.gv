// Figure 11-1 — Routing. Selection is not authority.
// Message: the router decides WHO should handle the work. It never decides
// whether the work is permitted -- that is a separate policy decision, and a
// low-confidence route falls back rather than guessing.
digraph pattern_routing {
  rankdir = TB
  graph [ranksep=0.40, nodesep=0.20]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.12,0.07", height=0.40, width=1.6]
  edge [arrowsize=0.65, penwidth=1.5, color="#1450A3"]

  req [label="Request", fillcolor="#EEF4FA", color="#4A6078"]
  cls [label="Classify\nintent · risk · confidence", shape=diamond, style=filled,
       fillcolor="#FFF4DF", color="#8A5600", height=0.75, width=2.3]
  s1  [label="Specialist A", fillcolor="#E7F5F3", color="#0D6E69"]
  s2  [label="Specialist B", fillcolor="#E7F5F3", color="#0D6E69"]
  fb  [label="Fallback\nhuman or safe default", fillcolor="#EEF4FA", color="#4A6078", width=2.0]
  pol [label="Policy decision\nmay this subject use it?", fillcolor="#FCECEC",
       color="#A62C2C", width=2.4]

  req -> cls
  cls -> s1 [label=" high", fontsize=9, fontcolor="#4A6078"]
  cls -> s2 [label=" high", fontsize=9, fontcolor="#4A6078"]
  cls -> fb [label=" low confidence", fontsize=9, fontcolor="#4A6078", color="#4A6078"]
  s1 -> pol [color="#A62C2C", style=dashed, arrowsize=0.55]
  s2 -> pol [color="#A62C2C", style=dashed, arrowsize=0.55]

  { rank=same; s1 -> s2 -> fb [style=invis] }
}
