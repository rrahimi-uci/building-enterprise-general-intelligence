// Figure 8-1 — Discovery proposes; resolution disposes.
//
// Message: the two halves have different rules on purpose. Discovery may be
// fuzzy and may return several candidates, because nothing it returns is yet
// permitted. Resolution is deterministic and returns exactly one pinned digest
// or a refusal naming the rule -- and the model has no input to it.
//
// Layout: vertical, with the model's reach marked. The dashed barrier is the
// point of the figure; a system that lets a model choose among discovery
// results has skipped it.
digraph skill_resolution {
  rankdir = TB
  graph [ranksep=0.24, nodesep=0.30]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.13,0.07", height=0.40, width=2.25]
  edge [arrowsize=0.65, penwidth=1.5, color="#1450A3"]

  need [label="Capability need\n\"read mortgage evidence\"", fillcolor="#E7F5F3", color="#0D6E69"]
  cat  [label="Catalog search\nsemantic, broad", fillcolor="#E6F5F9", color="#0B6076"]
  cand [label="Candidates\nmortgage.evidence.read @ 0.1.0, 0.1.1", shape=note,
        style=filled, fillcolor="#E6F5F9", color="#0B6076"]

  pol  [label="Policy evaluation against the run envelope\ntenant · purpose · grants · region · risk", shape=diamond,
        style=filled, fillcolor="#FFF4DF", color="#8A5600", height=0.86, width=3.3]
  pin  [label="Pinned release\nsha256:9f3c… — exactly one", fillcolor="#EAF3FB", color="#1450A3"]
  no   [label="Refusal\nnaming the rule that denied it", fillcolor="#FCECEC", color="#A62C2C"]

  d1 [label=<<B><FONT POINT-SIZE="10" COLOR="#0B6076">DISCOVERY &#183; what exists</FONT></B>>, shape=plaintext, style=""]
  d2 [label=<<B><FONT POINT-SIZE="10" COLOR="#8A5600">RESOLUTION &#183; what this run may use</FONT></B>>, shape=plaintext, style=""]
  mr [label="the model may describe\nthe need — and nothing below", shape=plaintext,
      style="", fontsize=9.5, fontcolor="#A62C2C"]

  need -> cat -> cand -> pol -> pin
  pol -> no [color="#A62C2C", style=dashed, penwidth=1.3]

  { rank=same; need -> d1 [style=invis] }
  { rank=same; cand -> mr [style=invis] }
  { rank=same; pol  -> d2 [style=invis] }
  { rank=same; pin  -> no [style=invis] }
}
