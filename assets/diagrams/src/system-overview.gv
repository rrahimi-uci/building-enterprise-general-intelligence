// Figure 1-3 — The whole system at a thousand feet.
//
// Message: this is the destination. Each band maps to the Parts that develop it, authority
// narrows as you read down, and the two concerns that do not sit in the stack
// -- security, and the platform that builds and runs it -- flank it.
//
// This is deliberately the same visual language as Figure 4-1 (same palette,
// same spine construct, same downward request path) at a lower resolution, so
// that a reader arriving at Chapter 4 recognises the drill-down instead of
// meeting a new notation. Bands here are single nodes; in Figure 4-1 they open
// up into containers of named components. Nothing in this figure should be more
// specific than a band name and what it owns.
//
// Layout note: each spine is a cluster of chained nodes, exactly as in Figure
// 4-1. Holding a single tall node on the middle rank with `rank=same` looks
// like it should work and does not: the tall node inflates that one rank, which
// tears a gap through the middle of the stack.
digraph system_overview {
  rankdir = TB
  graph [ranksep=0.24, nodesep=0.34]
  node [shape=plaintext, style="", margin=0]

  subgraph cluster_sec {
    label = <<B>VI &#183; Security</B>>
    fontsize = 12; fontcolor = "#A62C2C"
    style = filled; fillcolor = "#FBEFEF"; color = "#A62C2C"; penwidth = 1.5
    margin = 8
    node [shape=box, style="filled,rounded", penwidth=1.2, fontsize=10,
          fillcolor="#FCECEC", color="#A62C2C", width=1.25, height=0.32,
          margin="0.10,0.06"]
    c0 [label="Identity"]
    cx [label="Least privilege"]
    c1 [label="Guardrails"]
    c2 [label="Approvals"]
    c3 [label="Containment"]
    c4 [label="Audit"]
    c5 [label="Fail closed"]
    c0 -> cx -> c1 -> c2 -> c3 -> c4 -> c5 [style=invis]
  }

  // ------------------------------------------------------------- the bands --
  // badge (Part) | name | what it owns
  ch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#4A6078" BGCOLOR="#EEF4FA">
    <TR><TD WIDTH="56" BGCOLOR="#4A6078" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>I</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Channels</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">who asks for work, and who sees the result</FONT></TD></TR></TABLE>>]

  rt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0D6E69" BGCOLOR="#E7F5F3">
    <TR><TD WIDTH="56" BGCOLOR="#0D6E69" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>I · IV</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Agent runtime</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">bounded reasoning, patterns, durable run state</FONT></TD></TR></TABLE>>]

  ma [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6A2E6E" BGCOLOR="#F7ECF8">
    <TR><TD WIDTH="56" BGCOLOR="#6A2E6E" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>V</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Collaboration</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">specialists, peer agents, external protocols</FONT></TD></TR></TABLE>>]

  kn [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#0B6076" BGCOLOR="#E6F5F9">
    <TR><TD WIDTH="56" BGCOLOR="#0B6076" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>II</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Knowledge</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">governed knowledge, rules, catalogs, per-run context</FONT></TD></TR></TABLE>>]

  gw [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#1450A3" BGCOLOR="#EAF3FB">
    <TR><TD WIDTH="56" BGCOLOR="#1450A3" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>IV&#8211;VII</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Control points</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">admission, inference, effects, and approval</FONT></TD></TR></TABLE>>]

  sor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#6A2E6E" BGCOLOR="#F1E3F3">
    <TR><TD WIDTH="56" BGCOLOR="#6A2E6E" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>—</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Systems of record</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">where effects commit and stay authoritative</FONT></TD></TR></TABLE>>]

  obs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#8A5600" BGCOLOR="#FFF4DF">
    <TR><TD WIDTH="56" BGCOLOR="#8A5600" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="11"><B>VII</B></FONT></TD>
        <TD WIDTH="150" ALIGN="LEFT"><B>Evidence</B></TD>
        <TD WIDTH="268" ALIGN="LEFT"><FONT POINT-SIZE="11">traces, evaluation, the loop into the next release</FONT></TD></TR></TABLE>>]

  // ----------------------------------------------------------- the spines --
  // Tall, because the prose says security spans every band. Drawing it as a
  // band -- which this figure used to do -- contradicts the sentence printed
  // directly beneath it.
  subgraph cluster_ops {
    label = <<B>III &#183; VIII &#183; Platform</B>>
    fontsize = 12; fontcolor = "#4A6078"
    style = filled; fillcolor = "#F2F6FA"; color = "#4A6078"; penwidth = 1.5
    margin = 8
    node [shape=box, style="filled,rounded", penwidth=1.2, fontsize=10,
          fillcolor="#EEF4FA", color="#4A6078", width=1.25, height=0.32,
          margin="0.10,0.06"]
    p0 [label="Golden paths"]
    p1 [label="SDK"]
    p2 [label="Release"]
    p3 [label="Operations"]
    p4 [label="Governance"]
    p5 [label="Cost"]
    px [label="Incidents"]
    p0 -> p1 -> p2 -> p3 -> p4 -> p5 -> px [style=invis]
  }

  // -------------------------------------------------------- authority axis --
  // The descent is the argument: the agent proposes at the top, the platform
  // authorizes in the middle, and only the bottom bands commit.
  edge [color="#1450A3", penwidth=1.7, arrowsize=0.8]
  ch -> rt [xlabel=" proposes  "]
  rt -> ma
  ma -> kn
  kn -> gw [xlabel=" authorizes  "]
  gw -> sor [xlabel=" commits  "]
  sor -> obs

  // Evidence closes the loop back to the runtime, which is why it is a band and
  // not an endpoint.
  edge [style=dotted, color="#8A5600", penwidth=1.4, constraint=false,
        xlabel="  learns"]
  obs -> rt

  // Security and platform touch every band; two short unconstrained edges each
  // say so without drawing fourteen lines over the stack.
  edge [style=dashed, color="#A62C2C", penwidth=1.2, arrowsize=0.55, xlabel=""]
  c1 -> rt
  c1 -> gw

  edge [style=dashed, color="#4A6078", penwidth=1.2]
  p0 -> rt
  p2 -> obs
}
