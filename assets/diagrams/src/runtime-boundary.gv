// Figure 3-1 — One bounded agent step across the platform/framework boundary.
// Message: the framework supplies local execution mechanics; the platform owns
// the request contract, authority, business effects, and durable evidence.
digraph runtime_boundary {
  rankdir = TB
  graph [ranksep=0.34, nodesep=0.30, compound=true]
  node [width=1.85, fontsize=11]

  request [label="AgentStepRequest\nidentity · context · bounds", shape=note,
           fillcolor="#EAF3FB", color="#1450A3"]
  adapter [label="AgentRuntime adapter\ntranslate · constrain · map", fillcolor="#E7F5F3", color="#0D6E69"]
  result [label="AgentStepResult\nproposal · evidence · usage", shape=note,
          fillcolor="#E6F5F9", color="#0B6076"]

  subgraph cluster_framework {
    label="  Bounded framework execution · no enterprise authority  "
    labeljust="l"
    fontsize=12
    fontcolor="#0D6E69"
    color="#0D6E69"
    style="rounded"
    margin=14
    bgcolor="#F4FBFA"

    agent [label="Agent loop\nreason · observe · stop", fillcolor="#E7F5F3", color="#0D6E69"]
    model [label="Model provider\ninference only", fillcolor="#EEF4FA", color="#4A6078"]
    tool_call [label="Eligible tool\nproposal", fillcolor="#E7F5F3", color="#0D6E69"]
    agent -> model [label="  inference  ", style=dashed, color="#4A6078", fontcolor="#4A6078"]
    model -> agent [label="  response  ", style=dashed, color="#4A6078", fontcolor="#4A6078"]
    agent -> tool_call [label="  choose  "]
  }

  gateway [label="Tool Gateway\nvalidate · authorize · dispatch", fillcolor="#EAF3FB", color="#1450A3"]
  policy [label="Exact resource\nand policy?", shape=diamond, fillcolor="#FFF4DF", color="#8A5600"]
  domain [label="Domain service\ncommit business effect", fillcolor="#EAF3FB", color="#1450A3"]
  receipt [label="Effect receipt\nworkflow evidence", shape=cylinder, fillcolor="#F7ECF8", color="#6A2E6E"]
  refuse [label="Refuse\nno effect", fillcolor="#FCECEC", color="#A62C2C"]

  request -> adapter [label="  bounded contract  "]
  adapter -> agent [label="  framework-native inputs  ", lhead=cluster_framework]
  agent -> result [label="  structured outcome  ", ltail=cluster_framework]
  tool_call -> gateway [label="  proposal only  ", ltail=cluster_framework]
  gateway -> policy [label="  re-check exact action  ", style=dashed, color="#8A5600", fontcolor="#8A5600"]
  policy -> domain [label="  allowed  ", color="#1450A3"]
  policy -> refuse [label="  denied  ", color="#A62C2C", fontcolor="#A62C2C"]
  domain -> receipt [label="  verified commit  ", color="#6A2E6E", fontcolor="#6A2E6E"]
  result -> receipt [label="  linked evidence  ", style=dotted, color="#6A2E6E", fontcolor="#6A2E6E"]
}
