// Figure 13-1 — Reflection. Improvement without self-certification.
// Message: the produce-check-judge-revise loop is bounded. Executable checks run
// before the judge, and the judge's score is advisory. Acceptance is decided
// outside the loop, by an engine the loop cannot reach -- otherwise the system
// grades its own homework. Every exit (accept, reject, escalate) is the engine's.
digraph pattern_reflection {
  rankdir = TB
  graph [ranksep=0.36, nodesep=0.26]
  node [shape=box, style="filled,rounded", penwidth=1.4, fontsize=10.5,
        margin="0.12,0.07", height=0.40, width=1.6]
  edge [arrowsize=0.65, penwidth=1.5, color="#0D6E69"]

  pro [label="Produce\ncandidate", fillcolor="#E7F5F3", color="#0D6E69"]
  chk [label="Executable checks\nschema · evidence · arithmetic · policy", fillcolor="#EAF3FB",
       color="#1450A3", width=2.6]
  ev  [label="Judge\nqualitative · advisory", fillcolor="#E6F5F9", color="#0B6076", width=1.9]
  gate [label="Acceptance engine\nchecks first · judge score as evidence", fillcolor="#FCECEC",
        color="#A62C2C", width=2.9]
  rev [label="Revise\nfrom typed defects and rationale", fillcolor="#E7F5F3", color="#0D6E69", width=2.1]
  cap [label="Revision cap\nn attempts · spend", fillcolor="#EAF3FB", color="#1450A3", width=1.7]
  out [label="Accepted", fillcolor="#FFF4DF", color="#8A5600", width=1.4]
  hum [label="Human intervention\nboth versions attached", fillcolor="#FCECEC", color="#A62C2C", width=2.0]

  pro -> chk -> ev
  chk -> gate [label=" fails · judge skipped", fontsize=10.5, fontcolor="#4A6078", style=dashed]
  ev -> gate [color="#A62C2C", label=" score + rationale · never self-accepts", fontsize=10.5, fontcolor="#A62C2C"]
  gate -> out [color="#8A5600", label=" accepted", fontsize=10.5, fontcolor="#8A5600"]
  gate -> rev [label=" rejected", fontsize=10.5, fontcolor="#4A6078"]
  gate -> hum [color="#A62C2C", label=" escalated\n cap · no progress", fontsize=10.5, fontcolor="#A62C2C"]
  rev -> pro [label=" while under cap", fontsize=10.5, fontcolor="#4A6078"]
  cap -> rev [color="#1450A3", style=dashed, arrowsize=0.55]

  { rank = same; out; rev; hum }
}
